{
  "version": 2,
  "name": "smart-homeopathic-college-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "https://smart-homeopathic-college-backend.onrender.com/api/v1/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://smart-homeopathic-college-backend.onrender.com/api/v1/$1"
    },
    {
      "src": "/library/books/(.*)",
      "dest": "https://smart-homeopathic-college-backend.onrender.com/api/v1/library/books/$1"
    },
    {
      "src": "/books/(.*)",
      "dest": "https://smart-homeopathic-college-backend.onrender.com/api/v1/books/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
